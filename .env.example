# ── TechTuxAcademy server environment ──────────────────────────────
# Copy this file to server/.env and fill in the values.
# Never commit a real .env file. These are safe example defaults.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (required in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/techtuxacademy?schema=public

# Direct (non-pooled) connection used by Prisma Migrate when DATABASE_URL points
# at a pooler (Supabase/Neon). Leave equal to DATABASE_URL for a direct database.
# In production with Supabase: DIRECT_URL is the port 5432 direct connection.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/techtuxacademy?schema=public

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Public URLs
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:4000
# Canonical public origin used in sitemap.xml, robots.txt and certificate links.
# In production set this to https://techtuxacademy.online
PUBLIC_SITE_URL=http://localhost:5173

# Cookie security
# Optional cookie domain for cross-subdomain deployments (e.g. .techtuxacademy.online)
COOKIE_DOMAIN=
# lax | strict | none. Use "none" only with HTTPS (required for cross-site cookies).
COOKIE_SAMESITE=lax

# Comma-separated list of allowed origins for cross-origin API requests.
# Leave blank when the client and API share the same origin (recommended in production).
CORS_ORIGINS=http://localhost:5173

# Email (SMTP). When omitted, emails are logged to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TechTuxAcademy <no-reply@techtuxacademy.online>"

# Optional Google Sign-In (Google Identity Services client ID)
GOOGLE_CLIENT_ID=

# Seed credentials (used only by `npm run db:seed` in development).
# Leave blank to use the demo accounts documented in README.md, or set your own.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_STUDENT_EMAIL=
SEED_STUDENT_PASSWORD=
# Seeding is blocked in production unless this is explicitly true.
# Never enable this on a public production database.
ALLOW_PROD_SEED=false

# Local embedded PostgreSQL (only used by `npm run db:start` / `npm run db:stop`)
EMBEDDED_PG_PORT=5433
EMBEDDED_PG_USER=postgres
EMBEDDED_PG_PASSWORD=postgres
EMBEDDED_PG_DATABASE=techtuxacademy

# ── Docker Compose only ───────────────────────────────────────────────
# These are read by docker-compose.yml, not by the app directly.
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=techtuxacademy
# Apply migrations automatically on container start (default true).
# RUN_MIGRATIONS=true
# Seed demo content on this container start (default false).
# RUN_SEED=false
