# TechTuxAcademy — Cloudflare Pages frontend environment variables.
#
# These are read at build time by Vite (import.meta.env.VITE_<KEY>).
# Set real values in the Cloudflare Pages dashboard under
# Settings → Environment variables — never commit production values.
#
# NOTE: No secrets go here. The frontend authenticates with an httpOnly
# session cookie and a CSRF cookie; there are no API tokens to expose.

# OPTIONAL — leave UNSET in the recommended deployment.
#
# The client defaults to the relative base `/api`. The Cloudflare Pages
# Functions proxy in `functions/api` forwards `/api/*` (and `functions/uploads`
# forwards `/uploads/*`) to the Render service, so the SPA works on
# techtuxacademy.online, www, and *.pages.dev without a build-time host — and
# cookies stay first-party.
#
# A cross-origin URL here is IGNORED unless VITE_ALLOW_REMOTE_API=true. A dead
# or unresolvable host would otherwise break every request (ERR_NAME_NOT_RESOLVED),
# and host-only SameSite=Lax cookies are not sent to a third-party origin.
#
# VITE_API_URL=https://api.techtuxacademy.online

# Set to `true` only for a deliberate split deployment where the SPA calls a
# different origin and the API sets cross-site cookies (SameSite=None; Secure).
# VITE_ALLOW_REMOTE_API=true
